# Configuration d'Auto Évasion — copier vers `.env` puis ajuster.
#
#   cp .env.example .env
#
# ⚠️ Le vrai `.env` n'est PAS dans le depot (ignore par git). En production il
# vit dans /srv/auto/shared/.env et systemd le lit (EnvironmentFile).

# Sert a signer la session Flask. Aucune donnee sensible n'y transite, mais une
# cle unique reste la regle.
SECRET_KEY=change-cette-cle

# Nom affiche dans l'onglet et l'entete.
SITE_NAME=Auto Évasion
SITE_TAGLINE=Saute par-dessus le trafic, débloque des autos, grimpe les 90 niveaux

# URL publique. En production : https://auto.gestiondojo.ca
APP_BASE_URL=http://127.0.0.1:5300
APP_PORT=5300

# Dossier ou vit le tableau des meilleurs scores (scores.json).
# En production : /srv/auto/shared/donnees — HORS de la release, sinon chaque
# mise en ligne effacerait le tableau.
DONNEES_DIR=donnees

# Cache navigateur des fichiers statiques, en secondes.
# 0 en developpement, 604800 en prod.
STATIC_MAX_AGE=0

# Mode debug Flask — jamais en production.
FLASK_DEBUG=false
